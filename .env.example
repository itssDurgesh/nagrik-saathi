# Copy to .env.local and fill in. Free key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: the first Gemini model to try (default: gemini-3.5-flash)
GEMINI_MODEL=
# Optional: comma-separated models to fall back to when one is out of free quota or busy
# (default: gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash,gemini-3.1-flash-lite)
GEMINI_FALLBACK_MODELS=
